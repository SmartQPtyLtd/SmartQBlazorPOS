<?xml version="1.0" encoding="utf-8"?>
<!--
  Pinned to nuget.org only, so restore is deterministic and never silently
  pulls from a machine-level feed. Nothing here should change without a
  deliberate decision — a POS that builds differently per machine is a
  support nightmare.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
